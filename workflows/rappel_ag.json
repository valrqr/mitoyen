            },
            {
              "id": "1845392b-6193-4e99-840e-e2384c911c81",
              "name": "au",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d6d12c90-123e-4420-ab96-0390de5c64bd",
      "name": "Rappels du jour",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REMPLACER",
          "name": "Moteur syndic"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.moteur_url }}/rappels-ag{{ $('Config').first().json.au ? '?au=' + $('Config').first().json.au : '' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      }
    },
    {
      "id": "e35b8784-8bf3-4234-9878-7aa906eb0fec",
      "name": "Un mail par destinataire",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        200
      ],
      "parameters": {
        "fieldToSplitOut": "envois",
        "options": {}
      }
    },
    {
      "id": "f771a42b-0b3d-40e4-afd6-704c181c33e7",
      "name": "Télécharger l'agenda (.ics)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REMPLACER",
          "name": "Moteur syndic"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.moteur_url }}{{ $('Un mail par destinataire').item.json.fichier_ics }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "bb0e48fd-f2de-4f65-af07-a96eed6ed82c",
      "name": "Envoyer le mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1680,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "REMPLACER",
          "name": "SMTP copro"
        }
      },
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.email_expediteur }}",
        "toEmail": "={{ $('Config').first().json.email_test || $('Un mail par destinataire').item.json.email }}",
        "subject": "={{ $('Config').first().json.email_test ? '[TEST ' + $('Un mail par destinataire').item.json.email + '] ' : '' }}{{ $('Un mail par destinataire').item.json.objet }}",
        "emailFormat": "text",
        "text": "={{ $('Un mail par destinataire').item.json.texte }}",
        "options": {
          "attachments": "={{ Object.keys($binary || {}).join(',') }}"
        }
      }
    },
    {
      "id": "2d7ab608-4887-4ff7-8c37-c56e9a8f724c",
      "name": "Copropriétaires au courrier",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        420
      ],
      "parameters": {
        "fieldToSplitOut": "courriers",
        "options": {}
      }
    },
    {
      "id": "71c5edcf-3d10-4563-893d-1352a0828155",
      "name": "Prévenir le syndic",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        420
      ],
      "credentials": {
        "smtp": {
          "id": "REMPLACER",
          "name": "SMTP copro"
        }
      },
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.email_expediteur }}",
        "toEmail": "={{ $('Config').first().json.email_test || $json.syndic_email }}",
        "subject": "={{ $('Config').first().json.email_test ? '[TEST] ' : '' }}{{ $json.rappel === 'résultats' ? \"Résultats d'AG\" : \"Rappel d'AG (\" + $json.rappel + \")\" }} : {{ $json.noms.length }} copropriétaire(s) au courrier",
        "emailFormat": "text",
        "text": "=Bonjour,\n\nLe mail « {{ $json.rappel }} » de l'assemblée générale du {{ $json.ag.slice(8,10) + '/' + $json.ag.slice(5,7) + '/' + $json.ag.slice(0,4) }} ({{ $json.copropriete }}) est parti par mail. Ces copropriétaires reçoivent leurs documents par courrier :\n\n{{ $json.noms.map(n => '- ' + n).join('\\n') }}\n\n{{ $json.note }}\n\nL'assistant du syndic",
        "options": {}
      }
    },
    {
      "id": "770a0984-6481-4f62-b1e1-cdfe5765e155",
      "name": "Mode d'emploi",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -140
      ],
      "parameters": {
        "width": 520,
        "height": 300,
        "content": "## Rappels et résultats d'assemblée générale\nChaque jour à 9h, Mitoyen envoie les mails dus ce jour-là :\n- **J-7** (ordre du jour, date limite du vote par correspondance) et **J-1** : avec « L'AG en bref » (ce qui sera décidé, ce que ça coûterait) et le fichier .ics de la réunion ;\n- **le lendemain du dépouillement** : ce qui a été décidé, avec « L'AG en bref » et, s'il a une dépense à payer, le fichier .ics de ses échéances.\n\n- **email_test** rempli : tous les mails arrivent à cette adresse (l'adresse réelle est rappelée dans l'objet). Vide : envoi réel\n- **au** vide = aujourd'hui. Pour tester : 7 jours avant une AG, ou le lendemain d'un dépouillement\n- Les copropriétaires au courrier ne reçoivent rien : le syndic reçoit leur liste\n\nCes mails ne remplacent ni la convocation ni le procès-verbal."
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.moteur_url }}{{ $json.fichier_pdf }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "pdf"
            }
          }
        }
      },
      "id": "3e68dad3-be25-4c92-94d1-aa7a1ab573f8",
      "name": "Télécharger l'AG en bref (.pdf)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REMPLACER",
          "name": "Moteur syndic"
        }
      }
    },
