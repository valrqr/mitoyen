    {
      "id": "c327493e-d836-49dd-b80d-1c34bddf6eb9",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "assignments": {
